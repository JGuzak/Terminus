{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Package Release",
            "type": "shell",
            "windows": {
                "command": "powershell.exe",
                "args": [
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/scripts/package_release.ps1",
                    "./release"
                ]
            },
            "linux": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/scripts/package_release.sh",
                    "./release"
                ]
            },
            "osx": {
                "command": "bash",
                "args": [
                    "${workspaceFolder}/scripts/package_release.sh",
                    "./release"
                ]
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
